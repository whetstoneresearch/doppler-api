# Required
# API_KEY authenticates callers. PRIVATE_KEY signs EVM transactions.
API_KEY=replace-with-api-key
PRIVATE_KEY=0xyour_private_key

# Comma-separated additional caller keys
API_KEYS=

# Server overrides
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
READY_RPC_TIMEOUT_MS=2000

# EVM chains
# At least one RPC URL is required. Each configured URL enables that chain.
ETHEREUM_RPC_URL=
MONAD_RPC_URL=
ROBINHOOD_RPC_URL=
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=

# Requests may omit chainId only when DEFAULT_CHAIN_ID names an enabled chain.
DEFAULT_CHAIN_ID=

# Requires DEFAULT_CHAIN_ID. Requests may override it with pairing.numeraireAddress.
DEFAULT_NUMERAIRE_ADDRESS=

# Deployment
# shared mode requires REDIS_URL, IDEMPOTENCY_ENABLED=true, and IDEMPOTENCY_BACKEND=redis.
DEPLOYMENT_MODE=standalone
REDIS_URL=
REDIS_KEY_PREFIX=doppler-api

# Idempotency is optional in standalone mode and required in shared mode.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_BACKEND=file
# Shared mode always requires idempotency keys.
IDEMPOTENCY_REQUIRE_KEY=false
IDEMPOTENCY_TTL_MS=86400000
IDEMPOTENCY_STORE_PATH=.data/idempotency-store.json
IDEMPOTENCY_REDIS_LOCK_TTL_MS=900000
IDEMPOTENCY_REDIS_LOCK_REFRESH_MS=300000

# EVM pricing
PRICE_ENABLED=true
PRICE_PROVIDER=coingecko
PRICE_BASE_URL=https://api.coingecko.com/api/v3
PRICE_TIMEOUT_MS=3000
PRICE_CACHE_TTL_MS=15000
PRICE_API_KEY=
PRICE_COINGECKO_ASSET_ID=ethereum

# Solana
# Enabling Solana requires SOLANA_KEYPAIR and both devnet endpoints.
SOLANA_ENABLED=false
SOLANA_DEFAULT_NETWORK=solanaDevnet
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
# Solana Mainnet Beta execution is not supported.
SOLANA_MAINNET_BETA_RPC_URL=
SOLANA_MAINNET_BETA_WS_URL=
# Prefer a local keypair file over inline secret-key bytes.
SOLANA_KEYPAIR_PATH=
SOLANA_KEYPAIR=
SOLANA_CONFIRM_TIMEOUT_MS=60000
SOLANA_DEVNET_ALT_ADDRESS=
# fixed mode requires SOLANA_FIXED_NUMERAIRE_PRICE_USD.
SOLANA_PRICE_MODE=required
SOLANA_FIXED_NUMERAIRE_PRICE_USD=
SOLANA_COINGECKO_ASSET_ID=solana

# Live tests
# LIVE_TEST_ENABLE=true runs live tests. EVM filters require DEFAULT_CHAIN_ID.
LIVE_TEST_ENABLE=false
LIVE_TEST_VERBOSE=false
LIVE_TEST_FILTER=all
LIVE_NUMERAIRE_PRICE_USD=3000
LIVE_TEST_MIN_BALANCE_ETH=
LIVE_TEST_ESTIMATED_TX_COST_ETH=
LIVE_TEST_ESTIMATED_OVERHEAD_ETH=
LIVE_TEST_MIN_BALANCE_SOL=
LIVE_TEST_ESTIMATED_TX_COST_SOL=
LIVE_TEST_ESTIMATED_OVERHEAD_SOL=
